# Separate Compose services for page-elements and table-structure (matching Helm).
# Both run the combined nemotron-object-detection:2.0.0 image; OCR stays on nim-ocr.
NIM_PAGE_ELEMENTS_URL=http://nim-page-elements:8000/v1/page-elements
NIM_TABLE_STRUCTURE_URL=http://nim-table-structure:8000/v1/table-structure
NIM_OCR_URL=http://nim-ocr:8000/v1/ocr
NIM_EMBED_URL=http://nim-embedding:8000/v1/embeddings
# Match the stable Nemotron 3.5 API alias for ingestion and queries.
NIM_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
